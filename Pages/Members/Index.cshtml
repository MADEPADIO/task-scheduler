@page
@model TaskSchedulerApp.Pages.Members.IndexModel
@{
	ViewData["Title"] = "Manage Members";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h1>Members</h1>
		<a asp-page="./Create" class="btn btn-primary">Add New Member</a>
	</div>

	@if (TempData["Error"] is string errorMsg)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@errorMsg
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="table-responsive shadow-sm rounded">
		<table class="table table-hover align-middle bg-white mb-0">
			<thead class="table-light">
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Role</th>
					<th>Notes</th>
					<th class="text-end">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var member in Model.Members)
				{
					<tr>
						<td class="fw-bold">@member.Name</td>
						<td>@member.Email</td>
						<td>
							<!-- Inline Toggle Admin -->
							<form method="post" asp-page-handler="ToggleAdmin" asp-route-id="@member.Id">
								@if (member.IsAdmin)
								{
									<button type="submit" class="btn btn-sm btn-primary rounded-pill px-3" title="Click to demote to Member">
										Admin
									</button>
								}
								else
								{
									<button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Click to promote to Admin">
										Member
									</button>
								}
							</form>
						</td>
						<td>
							@if (!string.IsNullOrEmpty(member.Notes))
							{
								<span class="text-muted small d-inline-block text-truncate" style="max-width: 200px;" title="@member.Notes">
									@member.Notes
								</span>
							}
							else
							{
								<span class="text-muted small fst-italic">No notes</span>
							}
						</td>
						<td class="text-end">
							<div class="d-flex justify-content-end gap-2">
								<!-- Edit Pencil -->
								<a asp-page="./Edit" asp-route-id="@member.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
										<path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10z" />
									</svg>
								</a>
								<!-- Delete Trash -->
								<form method="post" asp-page-handler="Delete" asp-route-id="@member.Id" onsubmit="return confirm('Are you sure you want to delete this member? All their assignments will be removed.');">
									<button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
											<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
											<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
										</svg>
									</button>
								</form>
							</div>
						</td>
					</tr>
				}
				@if (!Model.Members.Any())
				{
					<tr>
						<td colspan="5" class="text-center text-muted py-4">No members found. Add one to get started.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>