@page
@model TaskSchedulerApp.Pages.NotFoundModel
@{
	ViewData["Title"] = "Page Not Found";
}

<div class="container mt-5 text-center">
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card shadow-sm border-warning">
				<div class="card-body p-5">
					<h1 class="display-1 text-warning fw-bold mb-0">404</h1>
					<h3 class="mb-4">Page Not Found</h3>

					<p class="text-muted mb-4">
						The page you are looking for doesn't exist, was moved, or you don't have permission to view it.
					</p>

					<a asp-page="/Index" class="btn btn-primary">Return to Dashboard</a>
				</div>
			</div>
		</div>
	</div>
</div>