@page "{id:guid}"
@using TaskSchedulerApp.Models
@model TaskSchedulerApp.Pages.Assignments.IndexModel
@{
	ViewData["Title"] = $"Assignments - {Model.Service.Name}";
}

<div class="container-fluid mt-4 px-lg-5">
	<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
		<div>
			<h1 class="mb-0">Assignment Grid</h1>
			<p class="text-muted mb-0">@Model.Service.Name - @Model.Service.Date.ToString("dddd, MMMM dd, yyyy") at @Model.Service.StartTime.ToString("hh:mm tt")</p>
		</div>
		<a asp-page="/Services/Index" class="btn btn-outline-secondary">Back to Services</a>
	</div>

	@if (TempData["Success"] is string successMsg)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@successMsg
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] is string errorMsg)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@errorMsg
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<form method="post" asp-page-handler="Save" asp-route-serviceId="@Model.Service.Id">

				<div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom flex-wrap gap-2">
					<div class="form-check form-switch mb-0">
						<input class="form-check-input" type="checkbox" role="switch" id="overrideSwitch"
						@(Model.OverrideRules == true ? "checked" : "")
							   onchange="window.location.href='?id=@Model.Service.Id&OverrideRules=' + this.checked">
						<label class="form-check-label fw-bold text-danger" for="overrideSwitch">
							Override Max 2 Services Rule
						</label>
					</div>

					<!-- NEW: Copy Button -->
					<button type="submit" asp-page-handler="CopyLastWeek" asp-route-serviceId="@Model.Service.Id"
							class="btn btn-outline-primary btn-sm"
							onclick="return confirm('This will copy all assignments from the previous week into empty slots. Continue?');">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-files me-1" viewBox="0 0 16 16">
							<path d="M13 0H6a2 2 0 0 0-2 2 2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2 2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 13V4a2 2 0 0 0-2-2H5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1zM3 4a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4z" />
						</svg>
						Copy Last Week
					</button>
				</div>

				<div class="table-responsive">
					<table class="table table-bordered align-middle mb-0 text-center">
						<thead class="table-light">
							<tr>
								<th style="width: 250px; text-align: left;">Session</th>
								@foreach (var cam in Model.ActiveCameras)
								{
									<th>@cam.Name</th>
								}
							</tr>
						</thead>
						<tbody>
							@foreach (var session in Model.Service.Sessions)
							{
								<tr>
									<td class="text-start fw-bold bg-light">
										<span class="badge bg-secondary me-2">@session.Order</span>
										@session.Name
									</td>
									@foreach (var cam in Model.ActiveCameras)
									{
										// Get the full assignment object (can be null if unassigned)
										var existingAssignment = Model.ExistingAssignments[(session.Id, cam.Id)];
										var currentUserId = existingAssignment?.UserId;
										var disabledList = Model.DisabledUsers[(session.Id, cam.Id)];

										// NEW: Use standard Bootstrap background colors with opacity to make them stronger
										string cellClass = "";
										if (existingAssignment != null)
										{
											cellClass = existingAssignment.Status switch
											{
												AssignmentStatus.Attending => "bg-success bg-opacity-25", // Stronger Green
												AssignmentStatus.Absent => "bg-danger bg-opacity-25",     // Stronger Red
												AssignmentStatus.Pending => "bg-warning bg-opacity-25",   // Stronger Yellow
												_ => ""
											};
										}

										<td class="@cellClass">
											<select name="assign_@(session.Id)_@(cam.Id)" class="form-select form-select-sm">
												<option value="">-- Unassigned --</option>
												@foreach (var member in Model.ActiveMembers)
												{
													bool isSelected = currentUserId == member.Id;
													bool isDisabled = disabledList.Contains(member.Id);

													// NEW FIX: Only show the violation text if they are actually disabled
													string displayText = (isSelected && isDisabled) ? $"{member.Name} (Rule Violation)" : member.Name;
													string titleText = (isSelected && isDisabled) ? "Rule Violation: Max 2 services or same camera" : "";

													if (isSelected)
													{
														<option value="@member.Id" selected title="@titleText">
															@displayText
														</option>
													}
													else
													{
														<option value="@member.Id" disabled="@isDisabled">@member.Name</option>
													}
												}
											</select>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div class="card-footer bg-white text-end py-3">
					<button type="submit" class="btn btn-primary px-4">Save Assignments</button>
				</div>
			</form>
		</div>
	</div>
</div>