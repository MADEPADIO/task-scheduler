@page "{id:guid}"
@model TaskSchedulerApp.Pages.Assignments.IndexModel
@{
	ViewData["Title"] = $"Assignments - {Model.Service.Name}";
}

<div class="container-fluid mt-4 px-lg-5">
	<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
		<div>
			<h1 class="mb-0">Assignment Grid</h1>
			<p class="text-muted mb-0">@Model.Service.Name - @Model.Service.Date.ToString("dddd, MMMM dd, yyyy") at @Model.Service.StartTime.ToString("hh:mm tt")</p>
		</div>
		<a asp-page="/Services/Index" class="btn btn-outline-secondary">Back to Services</a>
	</div>

	@if (TempData["Success"] is string successMsg)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@successMsg
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] is string errorMsg)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@errorMsg
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<form method="post" asp-page-handler="Save" asp-route-serviceId="@Model.Service.Id">

				<!-- NEW: Override Toggle Switch -->
				<div class="card-header bg-white d-flex align-items-center py-3 border-bottom">
					<div class="form-check form-switch mb-0">
						<!-- The JS here reloads the page and appends ?OverrideRules=true or false to the URL -->
						<input class="form-check-input" type="checkbox" role="switch" id="overrideSwitch"
						@(Model.OverrideRules ? "checked" : "")
							   onchange="window.location.href='?id=@Model.Service.Id&OverrideRules=' + this.checked">
						<label class="form-check-label fw-bold text-danger" for="overrideSwitch">
							Override Max 2 Services Rule or Camera Rule
						</label>
						<span class="text-muted small ms-2">(Use only for emergencies)</span>
					</div>
				</div>

				<div class="table-responsive">
					<table class="table table-bordered align-middle mb-0 text-center">
						<thead class="table-light">
							<tr>
								<th style="width: 250px; text-align: left;">Session</th>
								@foreach (var cam in Model.ActiveCameras)
								{
									<th>@cam.Name</th>
								}
							</tr>
						</thead>
						<tbody>
							@foreach (var session in Model.Service.Sessions)
							{
								<tr>
									<td class="text-start fw-bold bg-light">
										<span class="badge bg-secondary me-2">@session.Order</span>
										@session.Name
									</td>
									@foreach (var cam in Model.ActiveCameras)
									{
										var currentUserId = Model.ExistingAssignments[session.Id][cam.Id];
										var disabledList = Model.DisabledUsers[(session.Id, cam.Id)];

										<td>
											<select name="assign_@(session.Id)_@(cam.Id)" class="form-select form-select-sm">
												<option value="">-- Unassigned --</option>
												@foreach (var member in Model.ActiveMembers)
												{
													bool isSelected = currentUserId == member.Id;
													bool isDisabled = disabledList.Contains(member.Id);

													if (isSelected)
													{
														// If they are selected BUT disabled, it means they are violating the rules.
														// We do NOT add disabled="disabled" here, so the Admin can select someone else to replace them.
														<option value="@member.Id" selected title="Rule Violation: Max 2 services or same camera">
															@member.Name (Rule Violation)
														</option>
													}
													else
													{
														<option value="@member.Id" disabled="@isDisabled">@member.Name</option>
													}
												}
											</select>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div class="card-footer bg-white text-end py-3">
					<button type="submit" class="btn btn-primary px-4">Save Assignments</button>
				</div>
			</form>
		</div>
	</div>
</div>