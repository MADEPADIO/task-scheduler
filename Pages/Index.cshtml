@page
@model TaskSchedulerApp.Pages.IndexModel
@{
	ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="display-5 fw-bold mb-0">Dashboard</h1>
			<p class="text-muted">Welcome back, Admin.</p>
		</div>
		<a asp-page="/Services/Generate" class="btn btn-success">Generate Schedule</a>
	</div>

	<!-- Quick Stats -->
	<div class="row mb-4">
		<div class="col-md-4 mb-3">
			<div class="card bg-primary text-white shadow-sm h-100">
				<div class="card-body">
					<h5 class="card-title text-uppercase text-white-50 small fw-bold">Active Members</h5>
					<h2 class="display-5 mb-0">@Model.TotalMembers</h2>
				</div>
				<div class="card-footer bg-primary border-top-0 text-end">
					<a asp-page="/Members/Index" class="text-white text-decoration-none small">Manage &rarr;</a>
				</div>
			</div>
		</div>

		<div class="col-md-4 mb-3">
			<div class="card bg-info text-white shadow-sm h-100">
				<div class="card-body">
					<h5 class="card-title text-uppercase text-white-50 small fw-bold">Active Cameras</h5>
					<h2 class="display-5 mb-0">@Model.TotalCameras</h2>
				</div>
				<div class="card-footer bg-info border-top-0 text-end">
					<a asp-page="/Cameras/Index" class="text-white text-decoration-none small">Manage &rarr;</a>
				</div>
			</div>
		</div>

		<div class="col-md-4 mb-3">
			<div class="card bg-secondary text-white shadow-sm h-100">
				<div class="card-body">
					<h5 class="card-title text-uppercase text-white-50 small fw-bold">Quick Links</h5>
					<ul class="list-unstyled mb-0 mt-2">
						<li class="mb-1"><a asp-page="/Services/Index" class="text-white text-decoration-none">View All Services</a></li>
						<li><a asp-page="/Services/Create" class="text-white text-decoration-none">Create Custom Service</a></li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Absence Warnings Section -->
	<!-- We use an if statement so this entire block is completely invisible unless the backend found absences in the database. -->

	@if (Model.RecentAbsences.Any())
	{
		<div class="alert alert-danger shadow-sm mb-4">
			<h4 class="alert-heading fw-bold mb-3">
				<!-- SVG Warning Triangle Icon -->
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
		<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
	</svg>
	Action Required: Member Absences
</h4>

<!-- Loop through the list of absences provided by the backend -->
<ul class="mb-0">
	@foreach (var absence in Model.RecentAbsences)
	{
<li class="mb-2">
			<!-- Display the member's name, the SERVICE NAME, the date, the session, and the camera they are missing -->
			<strong>@absence.User.Name</strong> is absent for
			<strong>@absence.Session.Service.Name</strong>
			(@absence.Session.Service.Date.ToString("ddd, MMM dd") - @absence.Session.Name)
			on <strong>@absence.Camera.Name</strong>.
			<br />
			<!-- Display the reason they gave, styled slightly muted -->
			<span class="text-muted small">Reason: <em>"@absence.AbsenceReason"</em></span>
		</li>
	}
</ul>
<hr />
<!-- Prompt the Admin to take action -->
<p class="mb-0 small">Please go to the Assignment Grid to manually reassign these cameras.</p>
</div>
}

<!-- Upcoming Services -->
<div class="card shadow-sm">
	<div class="card-header bg-white fw-bold">
		Next 3 Upcoming Services
	</div>
	<div class="table-responsive">
		<table class="table table-hover align-middle mb-0">
			<thead class="table-light">
				<tr>
					<th>Date</th>
					<th>Service</th>
					<th>Time</th>
					<th class="text-end">Action</th>
				</tr>
			</thead>
			<tbody>
				<!-- Loop through the services provided by the backend -->
				@foreach (var service in Model.UpcomingServices)
				{
					<tr>
						<td class="fw-bold">@service.Date.ToString("ddd, MMM dd")</td>
						<td>@service.Name</td>
						<td>@service.StartTime.ToString("hh:mm tt")</td>
						<td class="text-end">
							<a asp-page="/Assignments/Index" asp-route-id="@service.Id" class="btn btn-sm btn-outline-success">
								Assign Cameras
							</a>
						</td>
					</tr>
				}
				<!-- Fallback if the database is empty -->
				@if (!Model.UpcomingServices.Any())
				{
					<tr>
						<td colspan="4" class="text-center text-muted py-4">
							No upcoming services found. Click "Generate Schedule" to get started.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
</div>