@page
@model TaskSchedulerApp.Pages.Services.IndexModel
@{
	ViewData["Title"] = "Manage Services";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h1>Services</h1>
		<a asp-page="./Create" class="btn btn-primary">Create New Service</a>
	</div>

	<div class="table-responsive shadow-sm rounded">
		<table class="table table-hover align-middle bg-white mb-0">
			<thead class="table-light">
				<tr>
					<th>Date</th>
					<th>Service Name</th>
					<th>Start Time</th>
					<th>Sessions</th>
					<th class="text-end">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var service in Model.Services)
				{
					<tr>
						<td class="fw-bold">@service.Date.ToString("ddd, MMM dd, yyyy")</td>
						<td>@service.Name</td>
						<td>@service.StartTime.ToString("hh:mm tt")</td>
						<td>
							<span class="badge bg-secondary rounded-pill">@service.Sessions.Count</span>
						</td>
						<td class="text-end">
							<a asp-page="./Details" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">
								Manage Sessions
							</a>
						</td>
					</tr>
				}
				@if (!Model.Services.Any())
				{
					<tr>
						<td colspan="5" class="text-center text-muted py-4">No services scheduled yet. Create one to begin.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>