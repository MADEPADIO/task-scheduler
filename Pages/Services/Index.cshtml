@page
@model TaskSchedulerApp.Pages.Services.IndexModel
@{
	ViewData["Title"] = "Manage Services";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h1>Services</h1>
		<a asp-page="./Create" class="btn btn-primary">Create New Service</a>
	</div>

	<div class="table-responsive shadow-sm rounded">
		<table class="table table-hover align-middle bg-white mb-0">
			<thead class="table-light">
				<tr>
					<th>Date</th>
					<th>Service Name</th>
					<th>Start Time</th>
					<th>Sessions</th>
					<th class="text-end">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var service in Model.Services)
				{
					<tr>
						<td class="fw-bold">@service.Date.ToString("ddd, MMM dd, yyyy")</td>
						<td>@service.Name</td>
						<td>@service.StartTime.ToString("hh:mm tt")</td>
						<td>
							<span class="badge bg-secondary rounded-pill">@service.Sessions.Count</span>
						</td>
						                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-page="./Details" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">
                                    Manage Sessions
                                </a>
                                
                                <!-- Delete Service Form -->
                                <form method="post" asp-page-handler="Delete" asp-route-id="@service.Id" onsubmit="return confirm('WARNING: Deleting this service will permanently delete all its sessions and any camera assignments attached to it. Are you sure?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Service">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                          <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                          <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
					</tr>
				}
				@if (!Model.Services.Any())
				{
					<tr>
						<td colspan="5" class="text-center text-muted py-4">No services scheduled yet. Create one to begin.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>