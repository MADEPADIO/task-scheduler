@page
@model TaskSchedulerApp.Pages.AuditLogs.IndexModel
@{
	ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">
	<h1 class="mb-4">System Audit Logs</h1>
	<div class="table-responsive shadow-sm rounded">
		<table class="table table-sm table-striped align-middle bg-white mb-0">
			<thead class="table-dark">
				<tr>
					<th>Timestamp</th>
					<th>Action</th>
					<th>Entity</th>
					<th>Details</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var log in Model.Logs)
				{
					<tr>
						<td>@log.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")</td>
						<td>
							<span class="badge @(log.Action == "Added" ? "bg-success" : log.Action == "Deleted" ? "bg-danger" : "bg-warning text-dark")">
								@log.Action
							</span>
						</td>
						<td>@log.EntityName</td>
						<td class="text-muted small">@log.Details</td>
					</tr>
				}
				@if (!Model.Logs.Any())
				{
					<tr>
						<td colspan="4" class="text-center text-muted py-4">No actions recorded yet.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>