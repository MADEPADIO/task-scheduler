@page
@model TaskSchedulerApp.Pages.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Audit Logs</h1>
        <p class="text-muted small">A permanent record of all system changes.</p>
    </div>
    
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--ink); color: white;">
    <tr>
        <th style="color: white;">Timestamp</th>
        <th style="color: white;">Action</th>
        <th style="color: white;">User</th> <!-- NEW COLUMN -->
        <th style="color: white;">Entity</th>
        <th style="color: white;">Details</th>
    </tr>
</thead>
<tbody>
    @foreach (var log in Model.Logs)
    {
        <tr>
            <td class="text-muted small">@log.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")</td>
            <td>
                <span class="badge @(log.Action == "Added" ? "bg-success" : log.Action == "Deleted" ? "bg-danger" : "bg-warning text-dark")">
                    @log.Action
                </span>
            </td>
            <td class="fw-bold text-dark">@log.PerformedBy</td> <!-- NEW DATA -->
            <td class="fw-bold">@log.EntityName</td>
            <td class="text-muted small">@log.Details</td>
        </tr>
    }
    @if (!Model.Logs.Any())
    {
        <tr>
            <td colspan="5" class="text-center text-muted py-5">No actions recorded yet.</td>
        </tr>
    }
</tbody>
            </table>
        </div>
    </div>
</div>