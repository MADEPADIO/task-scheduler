@page
@using TaskSchedulerApp.Models
@model TaskSchedulerApp.Pages.Member.IndexModel
@{
    ViewData["Title"] = "My Schedule";
}

<div class="container mt-4 mb-5">
    <h1 class="fw-bold mb-4">My Schedule</h1>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.UpcomingServices.Any())
    {
        <div class="card p-5 text-center">
            <h4 class="text-muted">No upcoming services scheduled.</h4>
            <p class="mb-0">Check back later!</p>
        </div>
    }
    else
    {
        <form method="post" asp-page-handler="UpdateAllStatuses">
            @foreach (var service in Model.UpcomingServices)
            {
                <div class="card mb-4 border-0">
                    <div class="card-header p-4" style="background-color: var(--flame); border-bottom: none;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h4 class="mb-0 fw-bold" style="color: var(--ember);">@service.Date.ToString("dddd, MMMM dd")</h4>
                            <span class="badge bg-white text-dark shadow-sm">@service.StartTime.ToString("hh:mm tt")</span>
                        </div>
                        <div class="fw-bold" style="color: var(--ember); opacity: 0.8;">@service.Name</div>
                    </div>
                    
                    <div class="card-body p-0">
                        @foreach (var session in service.Sessions)
                        {
                            var myAssignmentsForSession = Model.MyAssignments
                                .Where(kvp => kvp.Key.Item1 == session.Id)
                                .Select(kvp => kvp.Value)
                                .ToList();

                            if (!myAssignmentsForSession.Any())
                            {
                                <div class="p-4 border-bottom d-flex justify-content-between align-items-center" style="background-color: #fafafa;">
                                    <span class="fw-bold text-muted">@session.Order. @session.Name</span>
                                    <span class="badge bg-secondary opacity-50">Resting</span>
                                </div>
                            }
                            else
                            {
                                foreach (var assignment in myAssignmentsForSession)
                                {
                                    <div class="p-4 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div>
                                                <h5 class="fw-bold mb-1">@session.Order. @session.Name</h5>
                                                <span class="badge bg-dark">@assignment.Camera.Name</span>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-column flex-sm-row gap-2">
                                            <select name="status_@assignment.Id" class="form-select form-select-sm status-select fw-bold" style="max-width: 220px;" data-assignment-id="@assignment.Id">
                                                @if (assignment.Status == AssignmentStatus.Attending) { <option value="Attending" selected>✅ I will be there</option> } else { <option value="Attending">✅ I will be there</option> }
                                                @if (assignment.Status == AssignmentStatus.Absent) { <option value="Absent" selected>❌ I cannot make it</option> } else { <option value="Absent">❌ I cannot make it</option> }
                                                @if (assignment.Status == AssignmentStatus.Pending) { <option value="Pending" selected>⏳ Pending</option> } else { <option value="Pending">⏳ Pending</option> }
                                            </select>
                                            <input type="text" name="reason_@assignment.Id" id="reason_@assignment.Id" 
                                                   class="form-control form-control-sm reason-input @(assignment.Status == AssignmentStatus.Absent ? "" : "d-none")" 
                                                   placeholder="Reason (if absent)" value="@assignment.AbsenceReason" />
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            }

            <div class="sticky-bottom bg-white p-3 border rounded shadow-lg mt-4 mb-4" style="z-index: 100;">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Save All Updates</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selects = document.querySelectorAll('.status-select');
            selects.forEach(select => {
                select.addEventListener('change', function () {
                    const assignmentId = this.getAttribute('data-assignment-id');
                    const reasonInput = document.getElementById('reason_' + assignmentId);
                    if (this.value === "Absent") {
                        reasonInput.classList.remove('d-none');
                        reasonInput.focus();
                    } else {
                        reasonInput.classList.add('d-none');
                        reasonInput.value = ''; 
                    }
                });
            });
        });
    </script>
}