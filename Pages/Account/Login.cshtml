@page
@model TaskSchedulerApp.Pages.Account.LoginModel
@{
	ViewData["Title"] = "Admin Login";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-5">
			<div class="card shadow-sm">
				<div class="card-body p-4">
					<h1 class="h3 mb-4 text-center">Admin Login</h1>

					<form method="post" id="loginForm">
						<div asp-validation-summary="All" class="text-danger mb-3"></div>
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

						<div class="mb-3">
							<label asp-for="Input.Email" class="form-label">Email</label>
							<input asp-for="Input.Email" class="form-control" type="email" id="emailInput" autocomplete="email" />
							<span asp-validation-for="Input.Email" class="text-danger small"></span>
						</div>

						<!-- Initially hidden. JS will reveal it if the email is an Admin. -->
						<div class="mb-3 d-none" id="passwordContainer">
							<label asp-for="Input.Password" class="form-label">Password</label>
							<input asp-for="Input.Password" class="form-control" id="passwordInput" />
							<span asp-validation-for="Input.Password" class="text-danger small"></span>
						</div>

						<button type="submit" class="btn btn-primary w-100 mt-2">Log In</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const emailInput = document.getElementById("emailInput");
			const passwordContainer = document.getElementById("passwordContainer");
			const passwordInput = document.getElementById("passwordInput");

			emailInput.addEventListener("blur", async function() {
				const email = this.value;

				// If email is empty, hide password and stop.
				if (!email) {
					passwordContainer.classList.add("d-none");
					passwordInput.value = "";
					return;
				}

				// Ask the server if this email is an admin
				const response = await fetch(`/Account/Login?handler=CheckAdmin&email=${encodeURIComponent(email)}`);
				const data = await response.json();

				if (data.isAdmin) {
					// Reveal the password field
					passwordContainer.classList.remove("d-none");
					passwordInput.focus(); // Put the cursor in the password box
					passwordInput.required = true; // Make HTML5 validation enforce it
				} else {
					// Hide the password field for members
					passwordContainer.classList.add("d-none");
					passwordInput.value = ""; // Clear any typed password
					passwordInput.required = false;
				}
			});
		});
	</script>
}